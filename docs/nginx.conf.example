# Dedicated vhost only. Replace DOMAIN and certificate paths.
# Include in nginx's http context. Do not attach to another project's vhost.
# Intentionally no request/access logs: those contain raw IP/path/headers.
limit_conn_zone $server_name zone=honeypot_connections:1m;

server {
    listen 443 ssl;
    server_name DOMAIN;
    ssl_certificate /PATH/fullchain.pem;
    ssl_certificate_key /PATH/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log off;
    error_log /dev/null crit;
    client_header_timeout 5s;
    client_body_timeout 5s;
    send_timeout 5s;
    keepalive_timeout 0;
    client_max_body_size 1k;
    large_client_header_buffers 2 8k;
    limit_conn honeypot_connections 32;

    location / {
        # No general outbound proxy: one fixed loopback experiment backend.
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Connection close;
        proxy_set_header Host honeypot-local;
        # Overwrite rather than append; trust only this loopback proxy in backend.
        proxy_set_header X-Honeypot-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header Authorization "";
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Transfer-Encoding "";
        proxy_connect_timeout 2s;
        proxy_send_timeout 3s;
        proxy_read_timeout 5s;
        proxy_buffering off;
        proxy_next_upstream off;
    }
}
